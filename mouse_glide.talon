not tag: user.mouse_glide_active
-
# [mouse] (glider | glide | galider | galide): user.mouse_glide_start()
[mouse] (glider | glide | galider | galide): user.mouse_glide_start(false, true)
# glide vertical: user.mouse_glide_start(false, true)
glide horizontal: user.mouse_glide_start(true, false)
glide omni: user.mouse_glide_start()